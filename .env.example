# Flask Secret Key for session signing & CSRF protection (generate a random 32+ char string in production)
FLASK_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
FLASK_ENV=development
FLASK_DEBUG=True

# Firebase Project Configuration (from your Firebase project settings)
FIREBASE_PROJECT_ID=message-app-80729
FIREBASE_API_KEY=AIzaSyB_RxGi8pwWYgndxsnOCZk30qlvYQOdSn4
FIREBASE_AUTH_DOMAIN=message-app-80729.firebaseapp.com
FIREBASE_STORAGE_BUCKET=message-app-80729.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=843218235016
FIREBASE_APP_ID=1:843218235016:web:f549adc01bd9b82ae5f93d

# Path to the Firebase Admin SDK Service Account JSON file
# Download this from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Place it securely in your project root or specified path and NEVER commit it to git
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
