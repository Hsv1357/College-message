rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile, administrators can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // Only administrators can create or update profiles via client (note: Firebase Admin SDK bypasses these rules)
      allow write: if isAdmin();
    }

    // User ID mapping collection: normalized user_id -> auth identity
    match /user_id_mappings/{mappingId} {
      // Read access restricted to admins (backend handles public login mapping lookups securely)
      allow read: if isAdmin();
      // Only admins can write user ID mappings
      allow write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
